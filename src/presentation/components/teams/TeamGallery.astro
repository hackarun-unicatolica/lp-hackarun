---
// grade de equipes confirmadas da página /equipes: HTML do build + lista ao vivo da planilha (TeamsView). Enquanto a
// lista ao vivo chega aparece "Carregando as equipes" (nada de contador em 0 nem vaga fantasma); se a planilha não
// responder, um aviso com "Tentar de novo"
import type { SlotsDTO, TeamDTO } from '@application/index';
import Button from '@presentation/components/ui/Button.astro';
import Icon from '@presentation/components/ui/Icon.astro';
import { toPublicTeam } from '@presentation/view-models/teams/TeamsViewModel';
import { registrationHref } from '@presentation/view-models/registration/registrationOrigin';
import TeamCard from './TeamCard.astro';
import TeamCounter from './TeamCounter.astro';

interface Props {
  teams: TeamDTO[];
  slots: SlotsDTO;
  // inscrições encerradas: o estado vazio não chama pra se inscrever
  registrationOpen?: boolean;
}

const { teams, slots, registrationOpen = true } = Astro.props;
// equipes confirmadas que o build já conhece (a lista ao vivo substitui)
const confirmed = teams.filter((t) => t.status === 'confirmed').map(toPublicTeam);
---

<div
  class="gallery"
  data-teams
  data-teams-initial={JSON.stringify(confirmed)}
  data-teams-slots={JSON.stringify(slots)}
  data-slots-level={slots.level}
>
  <div class="gallery__bar" data-teams-bar hidden={confirmed.length === 0}>
    <TeamCounter count={confirmed.length} slots={slots} />
    <div class="gallery__search" data-teams-search-wrap hidden>
      <label class="gallery__search-label" for="team-search">
        Buscar equipe
      </label>
      <span class="gallery__search-field">
        <Icon name="search" size={18} />
        <input
          id="team-search"
          class="gallery__search-input"
          type="search"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          placeholder="Nome da equipe"
          data-teams-search
        />
      </span>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-teams-live></p>

  <ol role="list" class="gallery__grid" data-teams-list hidden={confirmed.length === 0}>
    {confirmed.map((t) => (
      <TeamCard
        name={t.name}
        memberCount={t.memberCount}
        imageUrl={t.imageUrl}
        mascot={t.mascot}
        members={t.members}
      />
    ))}
  </ol>

  <p class="gallery__noresults" data-teams-noresults hidden>
    Nenhuma equipe com “<span data-teams-query></span>”. Confira a grafia do nome.
  </p>

  <div class="gallery__state" data-teams-loading role="status" hidden={confirmed.length > 0}>
    <span class="gallery__spinner" aria-hidden="true"></span>
    <p class="gallery__state-title">Carregando as equipes…</p>
  </div>

  <div class="gallery__state gallery__state--error" data-teams-error role="alert" hidden>
    <p class="gallery__state-title">Não deu para carregar as equipes agora.</p>
    <p class="gallery__state-text">Confira a internet e tente de novo.</p>
    <button class="gallery__retry" type="button" data-teams-retry>
      Tentar de novo
    </button>
  </div>

  <div class="gallery__state" data-teams-empty hidden>
    <p class="gallery__state-title">As equipes aparecem aqui logo depois do sorteio.</p>
    {registrationOpen && (
      <Button href={registrationHref('equipes')} registrationCta="equipes">
        Fazer minha inscrição
      </Button>
    )}
  </div>

  <template data-teams-template>
    <TeamCard />
  </template>
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--space-6);
  }

  .gallery__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .gallery__search {
    display: grid;
    gap: var(--space-2);
    width: min(100%, 22rem);
  }

  .gallery__search-label {
    color: var(--ink-cyan);
    font-family: var(--font-mono);
    font-size: var(--fs-hud);
    letter-spacing: var(--tracking-hud);
    text-transform: uppercase;
  }

  .gallery__search-field {
    position: relative;
    display: block;
    color: var(--text-dim);
  }

  .gallery__search-field :global(.icon) {
    position: absolute;
    top: 50%;
    left: var(--space-4);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .gallery__search-input {
    width: 100%;
    min-height: 48px;
    padding: 0 var(--space-4) 0 calc(var(--space-4) * 2 + 18px);
    border: 1px solid var(--control-line);
    border-radius: 3px;
    background: var(--control-bg);
    font-size: max(16px, var(--fs-base));
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  /* transparente (e não none): no alto contraste o box-shadow some e o contorno aparece */
  .gallery__search-input:focus-visible {
    outline: 2px solid transparent;
    border-color: var(--c-cyan);
    box-shadow:
      0 0 0 3px rgb(0 229 255 / 0.18),
      0 0 24px rgb(0 229 255 / 0.25);
  }

  /* celular: 2 por linha (cara de grid de largada); cresce até 4 */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .gallery__grid[aria-busy='true'] {
    opacity: 0.7;
  }

  .gallery__noresults {
    color: var(--text-muted);
  }

  /* carregando / erro / vazio: um bloco só, centrado, no lugar da grade */
  .gallery__state {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: clamp(2.5rem, 2rem + 4vw, 4.5rem) var(--space-5);
    border: 1px solid rgb(0 229 255 / 0.18);
    border-radius: 3px;
    background:
      radial-gradient(60% 80% at 50% 0%, rgb(18 100 255 / 0.16), transparent 70%), rgb(4 8 26 / 0.55);
    text-align: center;
  }

  .gallery__state[hidden] {
    display: none;
  }

  .gallery__state--error {
    border-color: rgb(255 77 141 / 0.35);
  }

  .gallery__state-title {
    color: var(--text);
    font-size: var(--fs-md, 1.15rem);
    font-weight: 600;
  }

  .gallery__state-text {
    color: var(--text-muted);
  }

  .gallery__spinner {
    width: 3rem;
    height: 3rem;
    border: 3px solid rgb(0 229 255 / 0.18);
    border-top-color: var(--c-cyan);
    border-radius: 50%;
    animation: gallery-spin 0.9s linear infinite;
    filter: drop-shadow(0 0 10px rgb(0 229 255 / 0.45));
  }

  @keyframes gallery-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .gallery__retry {
    min-height: 44px;
    padding: 0 var(--space-5);
    border: 1px solid var(--c-cyan);
    border-radius: 3px;
    background: rgb(0 229 255 / 0.08);
    color: var(--ink-cyan);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .gallery__retry:hover {
    background: rgb(0 229 255 / 0.16);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__spinner {
      animation-duration: 2.4s;
    }
  }

  @media (min-width: 40rem) {
    .gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (min-width: 64rem) {
    .gallery__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
