---
// tela dos NPCs das insígnias (no código, "gems"): cada NPC escolhe a cor (azul, amarelo ou vermelho) e sorteia só as questões da palestra
// dele, sem repetir até todas saírem. Fica atrás do mesmo login do sorteio (functions/_middleware.ts): as questões e o
// gabarito vêm da planilha só depois do login, nunca do código do site. Fora do menu e do sitemap, noindex
import displayFont from '../assets/fonts/orbitron-pt-latin-wght.woff2?url';
import bodyFont from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import { GEM_COLORS } from '@domain/gems/GemQueue';
import { GEM_TALKS } from '@presentation/views/gems/gemTalks';
import '@presentation/styles/tokens.css';
import '@presentation/gems/gems.css';

const fontFaces = [
  `@font-face{font-family:'Orbitron Variable';font-style:normal;font-display:swap;font-weight:400 900;src:url(${displayFont}) format('woff2')}`,
  `@font-face{font-family:'Montserrat Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${bodyFont}) format('woff2')}`,
].join('');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Insígnias dos NPCs · HackaRun 2026</title>
    <style set:html={fontFaces}></style>
  </head>
  <body class="gems">
    <header class="gems__top">
      <div>
        <p class="gems__eyebrow">// HackaRun 2026 · organização</p>
        <h1>Insígnias dos NPCs</h1>
      </div>
      <form method="post" action="/sorteio/sair">
        <input type="hidden" name="voltar" value="/insignias" />
        <button class="gems__btn gems__btn--ghost gems__btn--small" type="submit">
          Sair
        </button>
      </form>
    </header>

    <p class="gems__warning" data-storage-warning hidden>
      Este navegador não está guardando dados (aba anônima ou armazenamento bloqueado). Use uma aba normal:
      sem isso, a fila se perde se a internet cair.
    </p>

    <main>
      <section class="gems__pick" data-pick hidden aria-labelledby="pick-title">
        <h2 id="pick-title">O que este aparelho vai fazer?</h2>
        <p class="gems__lead">
          A escolha fica guardada neste aparelho. Cada cor sorteia só as questões da sua palestra; a entrega
          final marca as equipes que mostraram as 3 fichas.
        </p>
        <div class="gems__colors">
          {GEM_COLORS.map((color) => (
            <button class="gems__color" type="button" data-color={color} data-gem-color={color}>
              <span class="gems__gem" aria-hidden="true" />
              <strong>{GEM_TALKS[color].label}</strong>
              <span>{GEM_TALKS[color].talk}</span>
            </button>
          ))}
          <button class="gems__color gems__color--delivery" type="button" data-mode="entrega">
            <span class="gems__gem gems__gem--all" aria-hidden="true" />
            <strong>Entrega final</strong>
            <span>Conferir as 3 insígnias</span>
          </button>
        </div>
      </section>

      <section class="gems__npc" data-delivery hidden aria-label="Entrega final das insígnias">
        <div class="gems__bar">
          <p class="gems__badge gems__badge--delivery">Entrega final · conferir as 3 insígnias</p>
          <button class="gems__btn gems__btn--ghost gems__btn--small" type="button" data-delivery-change>
            Trocar
          </button>
        </div>
        <p class="gems__progress" data-delivery-count>
          Carregando as equipes…
        </p>

        <form class="gems__card gems__delivery-form" data-delivery-form>
          <label for="delivery-team">Equipe que mostrou as fichas azul, amarela e vermelha</label>
          <input
            id="delivery-team"
            data-delivery-input
            list="delivery-teams"
            autocomplete="off"
            placeholder="Digite o nome da equipe"
            required
          />
          <datalist id="delivery-teams" data-delivery-options></datalist>
          <button class="gems__btn" type="submit" data-delivery-submit>
            Completou as 3 insígnias
          </button>
        </form>
        <p class="gems__sync" data-delivery-status role="status"></p>

        <h2 class="gems__subtitle">Completaram</h2>
        <ol class="gems__done-list" data-delivery-done></ol>

        <h2 class="gems__subtitle">
          Faltam <span class="gems__hint">(toque no nome para marcar)</span>
        </h2>
        <ul class="gems__chips" data-delivery-pending></ul>

        <button class="gems__btn gems__btn--ghost gems__btn--small" type="button" data-delivery-refresh>
          Atualizar lista
        </button>
      </section>

      <section class="gems__npc" data-npc hidden aria-label="Sorteio de questões">
        <div class="gems__bar">
          <p class="gems__badge" data-color-badge></p>
          <button class="gems__btn gems__btn--ghost gems__btn--small" type="button" data-change>
            Trocar cor
          </button>
        </div>
        <p class="gems__progress" data-progress></p>
        <div
          class="gems__meter"
          data-meter
          role="progressbar"
          aria-label="Carregando as questões"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          hidden
        >
          <p class="gems__meter-label" data-meter-label>
            Carregando as questões… 0%
          </p>
          <div class="gems__meter-track">
            <span class="gems__meter-fill" data-meter-fill></span>
          </div>
        </div>
        <p class="gems__load" data-load role="status"></p>

        <article class="gems__card" data-card aria-live="polite"></article>

        <div class="gems__actions">
          <button class="gems__btn" type="button" data-draw disabled>
            Sortear questão
          </button>
          <button class="gems__btn gems__btn--ghost" type="button" data-reveal aria-pressed="false" hidden>
            Mostrar resposta
          </button>
        </div>
        <p class="gems__sync" data-sync role="status"></p>
      </section>
    </main>

    <div class="gems__toast" data-toast role="status" aria-live="polite" hidden>
      <span data-toast-text></span>
      <button class="gems__toast-undo" type="button" data-toast-undo>
        Desfazer
      </button>
    </div>

    <script>
      import { createGemsServices } from '@composition/gems';
      import { mountGemsPage } from '@presentation/views/gems/mountGemsPage';

      const { gateway, store } = createGemsServices();
      mountGemsPage(gateway, store);
    </script>
  </body>
</html>
